# Copy to .env and fill in values. The app loads .env and optional .env.local.
# Existing environment variables take precedence, then .env.local, then .env.
# Used only by the initial setup command:
SHELLY_ADMIN_EMAIL=
SHELLY_ADMIN_PASSWORD=

# Optional shared password for reading already protected devices.
# Shellyficator does not change passwords on devices.
SHELLY_DEVICE_PASSWORD=

# Set true when accessing the dashboard through an HTTPS reverse proxy.
SHELLY_COOKIE_SECURE=false
# Optional OpenID Connect login. Set all four to enable; password login remains.
SHELLY_OIDC_ISSUER=
SHELLY_OIDC_CLIENT_ID=
SHELLY_OIDC_CLIENT_SECRET=
SHELLY_OIDC_REDIRECT_URL=
TZ=UTC
