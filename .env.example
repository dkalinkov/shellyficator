# Supply these as environment variables. The app does not load this file automatically.
# Used only by the initial setup command:
SHELLY_ADMIN_EMAIL=
SHELLY_ADMIN_PASSWORD=

# Optional shared password for reading already protected devices.
# This slice does not change passwords on devices.
SHELLY_DEVICE_PASSWORD=

# Set true when accessing the dashboard through an HTTPS reverse proxy.
SHELLY_COOKIE_SECURE=false
TZ=Europe/Sofia
