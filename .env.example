# Copy to .env. See docs/wiki/configuration.md for precedence.
# Used by the setup command.
SHELLY_ADMIN_EMAIL=
SHELLY_ADMIN_PASSWORD=

# Shared password for protected devices.
SHELLY_DEVICE_PASSWORD=

# Set true when accessing the dashboard through an HTTPS reverse proxy.
SHELLY_COOKIE_SECURE=false
# Optional OpenID Connect login. Set all four to enable; password login remains.
SHELLY_OIDC_ISSUER=
SHELLY_OIDC_CLIENT_ID=
SHELLY_OIDC_CLIENT_SECRET=
SHELLY_OIDC_REDIRECT_URL=
TZ=UTC
