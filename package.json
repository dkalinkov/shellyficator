{
  "name": "shellyficator-ui",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ui/styles.css -o internal/web/static/app.css --minify",
    "watch:css": "tailwindcss -i ui/styles.css -o internal/web/static/app.css --watch",
    "vendor": "node scripts/vendor.mjs",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "daisyui": "5.7.47",
    "htmx.org": "2.0.11",
    "@fontsource/ibm-plex-sans": "5.2.7"
  }
}
